# ============================================
# Cloud Deployment Environment Variables
# Recommended: Azure MySQL, MongoDB Atlas, Neo4j AuraDB
# Copy this file to .env.cloud and fill in your cloud credentials
# ============================================

# ============================================
# Azure MySQL Server Configuration (RECOMMENDED)
# ============================================
# Azure MySQL Server format: <server-name>.mysql.database.azure.com
# Username format: <user>@<server-name> (e.g., dbadmin@hotel-mysql-server)
# Created at: https://portal.azure.com/
MYSQL_HOST=hotel-mysql-server.mysql.database.azure.com
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_db
MYSQL_USER=dbadmin@hotel-mysql-server
MYSQL_PASSWORD=your_secure_azure_mysql_password_here

# ============================================
# MongoDB Atlas Configuration
# ============================================
# Connection string format: mongodb+srv://username:password@cluster.mongodb.net/database
# Available at: https://cloud.mongodb.com/v2/<project-id>#/clusters
MONGODB_ATLAS_URI=mongodb+srv://admin:your_secure_password@hotel-cluster.abc123.mongodb.net/hotel_db?retryWrites=true&w=majority

# ============================================
# Neo4j AuraDB Configuration (RECOMMENDED)
# ============================================
# Connection string format: neo4j+s://<instance-id>.databases.neo4j.io
# Available at: https://console.neo4j.io/ (formerly Aura)
# Note: Use neo4j+s:// for secure connections
NEO4J_AURA_URI=neo4j+s://abc12345xyz.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_auradb_password_here

# ============================================
# Spring Boot Profile
# ============================================
# Set to "cloud" to use application-cloud.properties
SPRING_PROFILES_ACTIVE=cloud

# ============================================
# Optional: AI Service Configuration
# ============================================
# In cloud, set to DISABLED or configure cloud LLM service
AI_OLLAMA_URL=DISABLED
AI_OLLAMA_MODEL=mistral:7b

# ============================================
# Optional: Logging Configuration
# ============================================
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_KEA_HOTEL_HOTELBACKEND=INFO

# ============================================
# Optional: Azure Credentials (if using Azure Key Vault)
# ============================================
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ============================================
# How to Use:
# ============================================
# 1. Copy this file: cp .env.cloud.example .env.cloud
# 2. Edit .env.cloud with your cloud credentials:
#    - Azure MySQL Server endpoint and credentials
#    - MongoDB Atlas connection string
#    - Neo4j AuraDB URI and credentials
# 3. For local testing:
#    export $(cat .env.cloud | xargs)
#    mvn spring-boot:run -Dspring-boot.run.arguments="--spring.profiles.active=cloud"
#
# 4. For Azure App Service deployment:
#    Use Azure Portal or Azure CLI to set application settings
#    Example: az webapp config appsettings set --resource-group <rg> --name <app-name> --settings @settings.json
