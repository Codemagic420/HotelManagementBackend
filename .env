# ============================================
# MySQL Configuration
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3307
MYSQL_DATABASE=hotel_db
MYSQL_ROOT_USERNAME=root
MYSQL_ROOT_PASSWORD=root

# Database Users - Created by 04_users_privileges.sql
MYSQL_ADMIN_USER=admin
MYSQL_ADMIN_PASSWORD=admin123

MYSQL_STAFF_USER=staff
MYSQL_STAFF_PASSWORD=staff123

MYSQL_GUEST_USER=user
MYSQL_GUEST_PASSWORD=user123

# Application-level user password
CLEANER_PASSWORD=cleaner123

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=hotel_db
MONGODB_USER=admin
MONGODB_PASSWORD=admin123
SPRING_DATA_MONGODB_URI=mongodb://admin:admin123@mongodb:27017/hotel_db?authSource=admin

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_AUTH=neo4j/yourpassword
SPRING_NEO4J_URI=bolt://neo4j:7687
SPRING_NEO4J_AUTHENTICATION_USERNAME=neo4j
SPRING_NEO4J_AUTHENTICATION_PASSWORD=yourpassword

# ============================================
# Spring Boot Application
# ============================================
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3307/hotel_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true

SERVER_PORT=8080
LOGGING_LEVEL_ROOT=INFO
