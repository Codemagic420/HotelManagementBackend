# ============================================
# Hotel Management System - Environment Variables
# Copy this file to .env and customize for your environment
# .env is NOT committed to git (see .gitignore)
#
# IMPORTANT FOR PRODUCTION:
# Replace all passwords with strong, unique values!
# Use: openssl rand -base64 32
# ============================================

# ============================================
# MySQL Configuration
# ============================================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=hotel_db
# PRODUCTION: Change this to a strong password (32+ chars, mixed case, numbers, symbols)
MYSQL_ROOT_PASSWORD=root

# Database Users - Created by 04_users_privileges.sql
MYSQL_USER=appuser
# PRODUCTION: Change this to a strong password (32+ chars, mixed case, numbers, symbols)
MYSQL_PASSWORD=apppassword123

# ============================================
# Spring Boot User Accounts
# PRODUCTION: Change ALL passwords to strong, unique values!
# These are used by DataInitializer to create user accounts
# These passwords are required and have no fallback
# ============================================
# PRODUCTION: Change this (used for admin@localhost login)
MYSQL_ADMIN_PASSWORD=admin123
# PRODUCTION: Change this (used for staff@localhost login)
MYSQL_STAFF_PASSWORD=staff123
# PRODUCTION: Change this (used for cleaner1-20@localhost login)
CLEANER_PASSWORD=cleaner123

# ============================================
# MongoDB Configuration
# ============================================
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGODB_DATABASE=hotel_db
MONGODB_PORT=27017

# ============================================
# Neo4j Configuration
# ============================================
NEO4J_AUTH=neo4j/CHANGE_ME_NEO4J_PASSWORD
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_PASSWORD
NEO4J_PORT=7687

# ============================================
# Spring Boot Application
# ============================================
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

SERVER_PORT=8080
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_KEA_HOTEL=INFO
